DIEX_IMAGE=ghcr.io/phdev7/twenty-diex
DIEX_IMAGE_TAG=replace-with-an-immutable-release-tag
SERVER_URL=https://next-crm.bydiex.com
# Internal address for the API-to-itself hop made by logic functions. Leave as
# the compose service name unless the server runs outside this network. The
# live Coolify deployment runs server and worker as two separate applications
# rather than this compose file, so there it is http://diex-twenty-server:3000
# — the network alias set on the server application.
SERVER_INTERNAL_URL=http://server:3000
# Express trusts forwarded protocol/host only from loopback and private proxy
# peers. Do not set true or a public CIDR unless the edge overwrites every
# X-Forwarded-* header.
TRUST_PROXY=loopback,linklocal,uniquelocal
SERVER_HOST=next-crm.bydiex.com
# Same value as SERVER_HOST with every dot escaped. Feeds the Traefik
# HostRegexp that routes tenant subdomains; an unescaped dot would match any
# character and expose the instance on hostnames you do not control.
SERVER_HOST_REGEX=next-crm\.bydiex\.com
DIEX_PROXY_ROUTER=diex-twenty-homolog
DIEX_ROBOTS_POLICY=noindex,nofollow,noarchive

# Multi-tenant routing. Each workspace answers at {subdomain}.${SERVER_HOST}
# and the instance default at ${DEFAULT_SUBDOMAIN}.${SERVER_HOST}.
# Prerequisites before setting this to true — in this order:
#   1. DNS wildcard *.${SERVER_HOST} pointing at the Coolify host;
#   2. wildcard certificate issued via a DNS-01 resolver (see DIEX_CERT_RESOLVER);
#   3. the existing workspace has the subdomain you expect to reach it by.
# Enabling it before 1 and 2 makes every login redirect to an unreachable host.
IS_MULTIWORKSPACE_ENABLED=false
DEFAULT_SUBDOMAIN=app
# Traefik resolver configured with the DNS provider. The HTTP-01 challenge
# cannot issue the *.${SERVER_HOST} SAN that tenant subdomains depend on.
DIEX_CERT_RESOLVER=letsencrypt

# Dedicated PostgreSQL and Redis resources in the same private Coolify network.
PG_DATABASE_URL=postgres://diex_twenty:replace@diex-twenty-postgres:5432/default
REDIS_URL=redis://default:replace@diex-twenty-redis:6379/0

# Generate and store only in Coolify. Never commit real values.
ENCRYPTION_KEY=replace-with-32-byte-random-value
FALLBACK_ENCRYPTION_KEY=
APP_SECRET=replace-with-independent-random-value

# Homologation may start with local persistent storage. Production must use S3.
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/packages/diex-server/.local-storage
# STORAGE_S3_REGION=auto
# STORAGE_S3_NAME=diex-crm-production
# STORAGE_S3_ENDPOINT=https://replace-with-s3-endpoint
# STORAGE_S3_ACCESS_KEY_ID=replace
# STORAGE_S3_SECRET_ACCESS_KEY=replace

EMAIL_DRIVER=LOGGER
EMAIL_FROM_ADDRESS=crm@bydiex.com
EMAIL_FROM_NAME=Diex
# EMAIL_SMTP_HOST=replace
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=replace
# EMAIL_SMTP_PASSWORD=replace
IS_EMAIL_VERIFICATION_REQUIRED=false

# Configure in the secure panel before enabling Diex AI features.
# OPENAI_API_KEY=replace
AI_MODELS_DEFAULT_FAST=openai/gpt-5-mini
AI_MODELS_DEFAULT_SMART=openai/gpt-5.2

# Exact origins only. No path, credentials or wildcard.
# DIEX_EVOLUTION_ALLOWED_ORIGINS=https://replace-with-evolution-origin
DIEX_EVOLUTION_ALLOW_PRIVATE_NETWORK=false

# Keep false. Enable only for the controlled, authenticated migration window.
DIEX_MIGRATION_API_ENABLED=false

# Public access-request form. Keep all values fail-closed until the operator
# workspace exists. The origin must be exact (scheme + host, no trailing slash,
# path, query, credentials or wildcard); a different host always receives 404.
ACCESS_REQUEST_INBOX_ENABLED=false
ACCESS_REQUEST_INBOX_WORKSPACE_ID=
ACCESS_REQUEST_INBOX_PUBLIC_ORIGIN=

LOG_LEVELS=error,warn
